<div class="about-img-wrap">
    <img src="images/about_img01.jpg" width="369" height="550" class="wow fadeInRight" data-wow-delay=".4s" />
    <img src="images/about_img02.jpg" width="223" height="473" class="wow fadeInRight" data-wow-delay=".2s" />
    <div class="about-experiences-wrap">
        @foreach (var item in _items.Select((value, index) => new { value, index }))
        {
            <div class="experiences-item">
                <div class="icon">
                    <img src="icons/about_icon0@((item.index + 1).ToString()).svg" width="35" height="35" alt="Icon {index + 1}" />
                </div>
                <div class="content">
                    <h6 class="title">@item.value</h6>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private List<string> _items { get; set; } = new()
    {
        { "Vi har över 10 års erfarenhet"},
        { "Team av kompetenta byggnadshantverkare"}
    };
}