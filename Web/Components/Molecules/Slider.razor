<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="testimonial-inner">
            <div id="carouselCompamyTestimonial" class="carousel carousel-dark slide testimonial-active-two" data-bs-ride="carousel">
                <div class="carousel-indicators">
                    <button type="button" class="active" data-bs-target="#carouselCompamyTestimonial" data-bs-slide-to="0" aria-current="true" aria-label="Slide 1"></button>
                    <button type="button" data-bs-target="#carouselCompamyTestimonial" data-bs-slide-to="1" aria-label="Slide 2"></button>
                    <button type="button" data-bs-target="#carouselCompamyTestimonial" data-bs-slide-to="2" aria-label="Slide 3"></button>
                </div>
                <div class="carousel-inner">
                    @foreach (var item in Reviews.Select((value, index) => new { value, index }))
                    {
                        <div class="carousel-item @(item.index == 0 ? "active" : "")">
                            <div class="testimonial-item-two">
                                <div class="testimonial-avatar-two">
                                    <img src="images/profile-male.svg" width="300" height="300" alt="" />
                                </div>
                                <div class="testimonial-content-two">
                                    <div class="content-top">
                                        <div class="icon">
                                            <i class="fas fa-quote-left" />
                                        </div>
                                        <div class="rating">
                                            <i class="fas fa-star" />
                                            <i class="fas fa-star" />
                                            <i class="fas fa-star" />
                                            <i class="fas fa-star" />
                                            <i class="fas fa-star" />
                                        </div>
                                    </div>
                                    <p>@item.value.Content</p>
                                    <div class="content-bottom">
                                        <h4 class="title">@item.value.Name</h4>
                                        <span>@item.value.Title</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public IEnumerable<Review> Reviews { get; set; } = new List<Review>();
}