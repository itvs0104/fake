<section class="inner-team-area pb-90">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="section-title text-center mb-60">
                    <span class="sub-title">De som gör idéer till verklighet</span>
                    <h2 class="title">Vårt Team</h2>
                </div>
            </div>
        </div>
        <div class="row justify-content-center">
            @foreach(var employee in _employees)
            {
                <div class="col-xl-3 col-lg-4 col-md-6 col-sm-10">
                    <div class="team-item">
                        <div class="team-thumb">
                            <img src="images/@employee.Value" width="278" height="435" alt="" />
                        </div>
                        <div class="team-content">
                            <h2 class="title">@employee.Key</h2>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private Dictionary<string, string> _employees = new()
    {
        {"Arunas", "team_img01.jpg"},
        {"Arturas", "team_img02.jpg"},
        {"Ivans", "team_img04.jpg"}
    };
}