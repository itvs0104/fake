@inject IJSRuntime JSRuntime

@if (string.IsNullOrEmpty(CurrentPage))
{
    <section class="services-area-two pb-90">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-12">
                    <div class="section-title white-title text-center mb-60 tg-heading-subheading animation-style3">
                        <span class="sub-title tg-element-title">Hantverk med hjärta</span>
                        <h2 class="title tg-element-title">Vårt utbud av tjänster</h2>
                    </div>
                </div>
            </div>
            <div class="row">
                @foreach (var item in _items.Take(2).Select((value, index) => new { value, index }))
                {
                    <div class="col-lg-6">
                        <div class="services-item-two">
                            <div class="services-thumb-two">
                                <img src="images/@item.value.Image" width={652} height={320} alt="" />
                            </div>
                            <div class="services-content-two">
                                <div class="icon">
                                    <img src="images/@item.value.Icon" width={40} height={40} alt="" />
                                </div>
                                <div class="content">
                                    <h2 class="title">@item.value.Title</h2>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <a class="btn" href="/services" data-animation-in="fadeInUp" data-delay-in=".8" data-duration-in=".6">Läs mer</a>
        </div>
    </section>
}
else
{
    <section class="features-area pt-120 pb-90">
        <div class="container">
            <div class="row justify-content-center">
                <div className="col-lg-6">
                    <div class="section-title text-center mb-50">
                        <span class="sub-title">Hantverk med hjärta</span>
                        <h2 class="title">Vårt utbud av tjänster</h2>
                    </div>
                </div>
            </div>
            <div class="row justify-content-center">
                @if (_isSmallScreen == true)
                {
                    @foreach (var item in _items.Select((value, index) => new { value, index }))
                    {
                        <div class="col-lg-4 col-md-6">
                            <div class="features-item wow fadeInUp" data-wow-delay="@_animationDelays[item.index]">
                                <div class="features-item-inner">
                                    <div class="features-content">
                                        <h4 class="title">@item.value.Title</h4>
                                        <p>@item.value.Description</p>
                                    </div>
                                    <div class="features-icon">
                                        <img src="images/@item.value.Icon" width="40" height="40" alt="" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    @foreach (var item in _items.Select((value, index) => new { value, index }))
                    {
                        <div class="col-lg-4 col-md-6 col-sm-10">
                            <div class="services-item wow fadeInUp" data-wow-delay="@_animationDelays[item.index]"
                                    style="background-image: url('images/@item.value.Image');"
                                    @onmouseover="() => HandleToggle(item.index + 1)"
                                    @onmouseout="() => HandleToggle(item.index + 1)">
                                <div class="services-icon" style="display: @(_isActive.Key == item.index + 1 ? "none" : "flex")">
                                    <img src="images/@item.value.Icon" width="50" height="50" alt="" />
                                </div>
                                <div class="services-content">
                                    <h2 class="title" style="display: @(_isActive.Key == item.index + 1 ? "none" : "block")">
                                        @item.value.Title
                                    </h2>
                                    <h2 class="number">
                                        @($"0{item.index + 1}")
                                    </h2>
                                </div>
                                <div class="services-overlay-content" style="display: @(_isActive.Key == item.index + 1 ? "block" : "none")">
                                    <h2 class="title">@item.value.Title</h2>
                                    <p>@item.value.Description</p>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </section>
}

@code {
    [Parameter]
    public string? CurrentPage { get; set; }

    private bool _isSmallScreen;
    private IReadOnlyList<string> _animationDelays = new List<string> { ".2s", ".4s", ".6s", ".3s", ".6s", ".9s" };
    private ActiveState _isActive = new(false, -1);
    private List<Skill> _items { get; set; } = new List<Skill>();

    private void HandleToggle(int key)
    {
        _isActive = _isActive.Key == key
            ? new ActiveState(false, -1)
            : new ActiveState(true, key);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("monitorScreenSize", DotNetObjectReference.Create(this));
        }
    }

    [JSInvokable]
    public void UpdateScreenSize(bool isSmall)
    {
        _isSmallScreen = isSmall;
        StateHasChanged();
    }

    public void Dispose()
    {
        JSRuntime.InvokeVoidAsync("removeScreenSizeListener");
    }

    private record ActiveState(bool Status, int Key);
}