@inject IJSRuntime JS
@inject IEmailService EmailService

<section class="appointment-area-two pb-120">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="appointment-inner-two tg-heading-subheading animation-style3" style="background-image: url('images/appointment_bg.jpg'">
                    <h2 class="title tg-element-title">Mötesförfrågan</h2>
                    <EditForm Model="@_dto" OnValidSubmit="@HandleSubmit">
                        <div class="contact-form">
                            <div class="row">
                                <div class="col-lg-4">
                                    <div class="form-grp">
                                        <input @bind="_dto.Name" type="text" placeholder="Namn *" required />
                                    </div>
                                </div>
                                <div class="col-lg-4">
                                    <div class="form-grp">
                                        <input @bind="_dto.Phone" type="text" placeholder="Mobil *" required />
                                    </div>
                                </div>
                                <div class="col-lg-4">
                                    <div class="form-grp">
                                        <input @bind="_dto.Email" type="email" placeholder="Email *" required />
                                    </div>
                                </div>
                                <div class="col-lg-8">
                                    <div class="form-grp">
                                        <textarea @bind="_dto.Message" name="message" placeholder="Meddelande *" required />
                                    </div>
                                </div>
                                <div class="col-lg-4">
                                    <button class="@(_isSending ? "btn-sending" : "btn")" disabled="@_isSending">
                                        @if (_isSending)
                                        {
                                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                            <span>Skickar...</span>
                                        }
                                        else
                                        {
                                            <span>Skicka</span>
                                        }
                                    </button>
                                </div>
                            </div>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</section>
@if (_isSend)
{
    <div class="mt-5 fade-out" id="confirmationMessage">
        <p class="link-success"><i class="fa-regular fa-circle-check"></i> Meddelande har skickats!</p>
    </div>
}

@code {
    private bool _isSending;
    private bool _isSend;
    private EmailMessage _dto = new();

    private async Task HandleSubmit()
    {
        _isSending = true;

        try
        {
            _dto.Subject = "Mötesförfrågan";

            _isSend = await EmailService.SendEmailAsync(_dto.Name, _dto.Email, _dto.Phone, _dto.Subject, _dto.Message);

            _dto = new EmailMessage();

            _isSending = false;

            StateHasChanged();

            await JS.InvokeVoidAsync("triggerFadeOut", "confirmationMessage");

            _isSend = false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to send email: {ex.Message}");

            throw new Exception(ex.Message);
        }
    }

    private class EmailMessage
    {
        public string Name { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Phone { get; set; } = string.Empty;
        public string Subject { get; set; } = string.Empty;
        public string Message { get; set; } = string.Empty;
    }
}